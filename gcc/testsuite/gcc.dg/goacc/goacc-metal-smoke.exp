# OpenACC smoke test driver for Apple Metal offload.
#
# This is intentionally conservative:
# - Runs only "compile" coverage (skips dg-do run/link) to avoid runtime
#   requirements while the offload runtime/plugin is still being brought up.
# - Filters out sources mentioning double/long double/_Complex to avoid known
#   Metal shading language limitations (double precision not supported).

load_lib gcc-dg.exp

if ![check_effective_target_fopenacc] {
  return
}

dg-init

set common_dir "$srcdir/c-c++-common/goacc"
set dg_dir "$srcdir/gcc.dg/goacc"
set all_tests [lsort [find $common_dir *.c]]
set dg_tests [lsort [find $dg_dir *.c]]
set tests {}

foreach t [concat $all_tests $dg_tests] {
  set f [open $t r]
  set c [read $f]
  close $f

  if {[regexp {dg-do[ \t]+run} $c]} {
    continue
  }
  if {[regexp {dg-do[ \t]+link} $c]} {
    continue
  }

  # Skip tests that are explicitly checking for diagnostics.
  if {[regexp {dg-(error|warning|bogus)} $c]} {
    continue
  }

  # Skip tests that validate internal dumps or warning TODOs; this is a
  # bring-up smoke that focuses on compile/link viability.
  if {[regexp {dg-final} $c]} {
    continue
  }
  if {[regexp {scan-tree-dump} $c]} {
    continue
  }
  if {[regexp {TODO} $c]} {
    continue
  }

  # This smoke is for the C frontend.
  if {![regexp {#pragma[ \t]+acc[ \t]} $c]} {
    continue
  }

  # Skip known unsupported FP modes/types for Metal.
  if {[regexp {\blong[ \t]+double\b} $c]} {
    continue
  }
  if {[regexp {\bdouble\b} $c]} {
    continue
  }
  if {[regexp {_Complex} $c]} {
    continue
  }

  lappend tests $t
}

dg-runtest $tests "" "-fopenacc -foffload=metal -g0"

dg-finish
